{
  "name": "watson-running",
  "description": "Watson's personal running platform.",
  "version": "1.0.0",
  "author": "Watson",
  "contributors": [
    "Yi Hong <zouzou0208@gmail.com>"
  ],
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@mapbox/mapbox-gl-language": "^1.0.1",
    "@mapbox/polyline": "^1.2.1",
    "@math.gl/web-mercator": "^4.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "gcoord": "^1.0.7",
    "html-to-image": "^1.11.13",
    "mapbox-gl": "^3.23.0",
    "maplibre-gl": "^6.11.2",
    "rc-virtual-list": "^3.19.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-map-gl": "^8.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "data:clean": "rm -f run_page/data.db {GPX,TCX,FIT}_OUT/* activities/* src/static/activities.json",
    "data:download:garmin": "python3 run_page/garmin_sync.py",
    "data:analysis": "python3 run_page/gen_svg.py --from-db --type github --output assets/github.svg",
    "build": "vite build",
    "develop": "vite dev",
    "dev": "vite dev",
    "serve": "vite serve",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "check": "prettier --check \"src/main.tsx\" \"src/**/*.{css,module.css,json,ts,tsx}\" \"*.{yaml,json,ts}\" \"assets/index.tsx\" \"eslint.config.mjs\"",
    "format": "prettier --write \"src/main.tsx\" \"src/**/*.{css,module.css,json,ts,tsx}\" \"*.{yaml,json,ts}\" \"assets/index.tsx\" \"eslint.config.mjs\"",
    "ci": "pnpm run format && pnpm run lint && pnpm run build",
    "test:chat": "node --test tests/run-agent-chat.test.mjs",
    "test:display": "node --test tests/activity-display.test.mjs",
    "test:summary": "node --test tests/activity-summary.test.mjs",
    "test:contracts": "node --test tests/run-agent-contract.test.mjs"
  },
  "engineStrict": true,
  "browserslist": "defaults, not ie 11",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bells/watson-running.git"
  },
  "homepage": "https://run.watsonzhu.cn/",
  "bugs": {
    "url": "https://github.com/bells/watson-running/issues"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@eslint/js": "^10.0.1",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
