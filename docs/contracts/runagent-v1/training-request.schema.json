{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunAgent v1 training request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "SUMMARY"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "adviceContext": {
          "$ref": "https://run.watsonzhu.cn/contracts/runagent-v1/advice.schema.json#/definitions/context"
        }
      },
      "required": ["kind", "startDate", "endDate"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "PERSONAL_BEST"
        },
        "distanceType": {
          "enum": ["FIVE_K", "TEN_K", "HALF_MARATHON", "MARATHON"]
        },
        "adviceContext": {
          "$ref": "https://run.watsonzhu.cn/contracts/runagent-v1/advice.schema.json#/definitions/context"
        }
      },
      "required": ["kind", "distanceType"],
      "additionalProperties": false
    }
  ]
}
