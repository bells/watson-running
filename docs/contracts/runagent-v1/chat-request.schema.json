{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PROPOSED RunAgent v1 chat-request",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "context": {
      "$ref": "https://run.watsonzhu.cn/contracts/runagent-v1/advice.schema.json#/definitions/context"
    }
  },
  "required": ["message"],
  "additionalProperties": false
}
