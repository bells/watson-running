{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PROPOSED RunAgent v1 stream-event",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "token"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requestId",
        "sequence",
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "complete"
        }
      },
      "required": [
        "requestId",
        "sequence",
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "AI_SERVICE_ERROR",
            "AGENT_TIMEOUT",
            "AGENT_TOOL_LIMIT",
            "RUNNING_DATA_UNAVAILABLE",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requestId",
        "sequence",
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
