{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PROPOSED RunAgent v1 chat-response",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "$ref": "https://run.watsonzhu.cn/contracts/runagent-v1/advice.schema.json#/definitions/evidence"
    }
  },
  "required": ["requestId", "content"],
  "additionalProperties": false
}
