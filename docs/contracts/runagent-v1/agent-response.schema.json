{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PROPOSED RunAgent v1 agent-response",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "executionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "toolCallCount": {
      "type": "integer",
      "minimum": 0
    },
    "content": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "conversationId",
    "executionId",
    "toolCallCount",
    "content"
  ],
  "additionalProperties": false
}
