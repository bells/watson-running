{
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "headers": [
    {
      "source": "/assets/:file(.*-[A-Za-z0-9_-]{8}\\.[A-Za-z0-9]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/chat",
      "destination": "https://run-api.watsonzhu.cn/api/v1/chat"
    },
    {
      "source": "/api/v1/training/stats",
      "destination": "https://run-api.watsonzhu.cn/api/v1/training/stats"
    },
    {
      "source": "/api/v1/runs/:runId([1-9][0-9]{0,15})/review",
      "destination": "https://run-api.watsonzhu.cn/api/v1/runs/:runId/review"
    },
    {
      "source": "/:spa((?!assets(?:/|$)|run-review-evidence(?:/|$)|api/v1/runs(?:/|$)|api/visitor-city(?:/|$)).*)",
      "destination": "/"
    }
  ]
}
